<Window x:Class="TaskTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskTracker.ViewModels"
        Title="Task Tracker" Icon="Assets/app.ico"
        Width="1240" Height="800" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════ SIDEBAR ════════════════════════ -->
        <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,22">

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Accent}">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="White" FontSize="18"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Task Tracker" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Plan your day, track your progress" Style="{StaticResource Muted}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <RadioButton x:Name="NavTasks" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True" AutomationProperties.Name="Daily Tasks">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE762;" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                            <TextBlock Text="Daily Tasks"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="nav" AutomationProperties.Name="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom tools -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,14"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsDarkTheme}" Margin="4,0,0,14">
                        <TextBlock Text="Dark mode" FontSize="13"/>
                    </CheckBox>
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ExportCsvCommand}" Margin="0,0,4,6"
                                Padding="8,7" ToolTip="Export all tasks to a CSV file (Excel)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Export CSV" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenDataFolderCommand}" Margin="4,0,0,6"
                                Padding="8,7" ToolTip="Open the folder that holds tasks.db">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Data folder" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding BackupCommand}" Margin="0,0,4,0"
                                Padding="8,7" ToolTip="Save a copy of your database">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Backup" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding RestoreCommand}" Margin="4,0,0,0"
                                Padding="8,7" ToolTip="Restore tasks from a backup file">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Restore" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- Month calendar -->
                <StackPanel>
                    <Grid Margin="4,0,0,10">
                        <TextBlock Text="{Binding DisplayMonthTitle}" Style="{StaticResource H2}" FontSize="14" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Padding="0"
                                    Command="{Binding PreviousMonthCommand}" ToolTip="Previous month">
                                <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Padding="0"
                                    Command="{Binding NextMonthCommand}" ToolTip="Next month">
                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding WeekDayHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding CalendarDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CalendarDay}">
                                <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Tooltip}"
                                        Cursor="Hand" Height="36" FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="cell" Background="Transparent" CornerRadius="8" Margin="1">
                                                <Grid>
                                                    <TextBlock x:Name="num" Text="{Binding DayNumber}" FontSize="12.5"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                    <Ellipse x:Name="dot" Width="5" Height="5" VerticalAlignment="Bottom"
                                                             Margin="0,0,0,4" Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="cell" Property="Background" Value="{DynamicResource CardHoverBg}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter TargetName="num" Property="Opacity" Value="0.35"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasPending}" Value="True">
                                                    <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAllDone}" Value="True">
                                                    <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="cell" Property="BorderThickness" Value="1.5"/>
                                                    <Setter TargetName="num" Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="cell" Property="Background" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="num" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="num" Property="FontWeight" Value="SemiBold"/>
                                                    <Setter TargetName="dot" Property="Fill" Value="White"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="6,10,0,0">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}"/>
                        <TextBlock Text="All done" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,16,0"/>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Warning}"/>
                        <TextBlock Text="Pending" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ════════════════════════ MAIN AREA ════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─────────────── DAILY TASKS PAGE ─────────────── -->
            <Grid Margin="32,26,32,10"
                  Visibility="{Binding IsChecked, ElementName=NavTasks, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedDateTitle}" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding SelectedDateSubtitle}" Style="{StaticResource Muted}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding PreviousDayCommand}" Padding="10,8" ToolTip="Previous day">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding GoTodayCommand}" Margin="6,0" Content="Today"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding NextDayCommand}" Padding="10,8" ToolTip="Next day">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Overdue banner -->
                <Border Grid.Row="1" Background="{DynamicResource WarningSoft}" CornerRadius="10" Padding="16,10" Margin="0,0,0,16"
                        Visibility="{Binding HasOverdue, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Warning}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding OverdueMessage}" Foreground="{DynamicResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource BaseButton}" Padding="12,6"
                                Background="{DynamicResource Warning}" Foreground="White" FontWeight="SemiBold"
                                Content="Move to today" Command="{Binding MoveOverdueToTodayCommand}"/>
                    </Grid>
                </Border>

                <!-- Stats row -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Completion" Style="{StaticResource Muted}"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="{Binding CompletedCount, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" done"/>
                                </TextBlock>
                            </Grid>
                            <TextBlock FontSize="30" FontWeight="SemiBold" Margin="0,4,0,8"
                                       Text="{Binding CompletionPercent, StringFormat={}{0:0.#}%}"/>
                            <ProgressBar Style="{StaticResource Progress}" Value="{Binding CompletionPercent, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/>
                                <TextBlock Text="Total" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalCount}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE930;" Style="{StaticResource Icon}" Foreground="{DynamicResource Success}" Margin="0,0,8,0"/>
                                <TextBlock Text="Completed" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CompletedCount}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Success}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" Foreground="{DynamicResource Warning}" Margin="0,0,8,0"/>
                                <TextBlock Text="Pending" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PendingCount}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Warning}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Add / edit form -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,10" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource H2}">
                                    <Setter Property="Text" Value="Add a new task"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Text" Value="Edit task"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox x:Name="TitleBox" Grid.Row="1" Style="{StaticResource InputBox}"
                                 Tag="What do you need to do?  (press Enter to save)" MaxLength="300"
                                 Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SaveTaskCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Cancel" Margin="0,0,8,0"
                                    Command="{Binding CancelEditCommand}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveTaskCommand}" MinWidth="120">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" Foreground="White"/>
                                    <TextBlock Text="{Binding FormButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}" FontSize="13" Tag="Notes (optional)" MaxLength="1000"
                                     Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SaveTaskCommand}"/>
                                    <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Priority" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="prio" Content="Low"
                                                     IsChecked="{Binding NewPriority, Converter={StaticResource Equals}, ConverterParameter=Low}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="prio" Content="Medium"
                                                     IsChecked="{Binding NewPriority, Converter={StaticResource Equals}, ConverterParameter=Medium}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="prio" Content="High"
                                                     IsChecked="{Binding NewPriority, Converter={StaticResource Equals}, ConverterParameter=High}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- List header + filter -->
                <Grid Grid.Row="4" Margin="0,0,0,10">
                    <TextBlock Text="Tasks" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="filter" Content="All"
                                         IsChecked="{Binding SelectedFilter, Converter={StaticResource Equals}, ConverterParameter=All}"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="filter" Content="Pending"
                                         IsChecked="{Binding SelectedFilter, Converter={StaticResource Equals}, ConverterParameter=Pending}"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="filter" Content="Completed"
                                         IsChecked="{Binding SelectedFilter, Converter={StaticResource Equals}, ConverterParameter=Completed}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Task list -->
                <Grid Grid.Row="5">
                    <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Muted}" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,40,0,0"
                               Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVis}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VisibleTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
                                    <Border x:Name="row" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,6,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Style="{StaticResource TaskCheck}" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsCompleted}" ToolTip="Mark as done / pending"/>

                                            <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="title" Text="{Binding Title}" FontSize="14.5"
                                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}" FontSize="12.5"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding CompletedLabel}" Style="{StaticResource Muted}" FontSize="11.5"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Border x:Name="badge" CornerRadius="6" Padding="9,3" VerticalAlignment="Center"
                                                        Background="{DynamicResource SuccessSoft}">
                                                    <TextBlock x:Name="badgeText" Text="{Binding PriorityLabel}" FontSize="11.5"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource Success}"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" ToolTip="Edit"
                                                        Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13"/>
                                                </Button>
                                                <Button Style="{StaticResource DangerIconButton}" ToolTip="Delete"
                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                            <Setter TargetName="badge" Property="Background" Value="{DynamicResource WarningSoft}"/>
                                            <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Warning}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="High">
                                            <Setter TargetName="badge" Property="Background" Value="{DynamicResource DangerSoft}"/>
                                            <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Danger}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter TargetName="title" Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Setter TargetName="row" Property="Opacity" Value="0.75"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ─────────────── DASHBOARD PAGE ─────────────── -->
            <ScrollViewer Margin="32,26,32,10" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsChecked, ElementName=NavDashboard, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                    <TextBlock Text="Your task completion at a glance" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,18"/>

                    <!-- Summary cards -->
                    <UniformGrid Columns="4" Margin="-7,0,-7,16">
                        <Border Style="{StaticResource Card}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Text="This week" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding WeekStat.Percent, StringFormat={}{0:0.#}%}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,8"/>
                                <ProgressBar Style="{StaticResource Progress}" Height="8" Value="{Binding WeekStat.Percent, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0">
                                    <Run Text="{Binding WeekStat.Completed, Mode=OneWay}"/><Run Text=" done · "/><Run Text="{Binding WeekStat.Pending, Mode=OneWay}"/><Run Text=" pending"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Text="This month" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding MonthStat.Percent, StringFormat={}{0:0.#}%}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,8"/>
                                <ProgressBar Style="{StaticResource Progress}" Height="8" Value="{Binding MonthStat.Percent, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0">
                                    <Run Text="{Binding MonthStat.Completed, Mode=OneWay}"/><Run Text=" done · "/><Run Text="{Binding MonthStat.Pending, Mode=OneWay}"/><Run Text=" pending"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Text="All time" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding AllTimeStat.Percent, StringFormat={}{0:0.#}%}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,8"/>
                                <ProgressBar Style="{StaticResource Progress}" Height="8" Value="{Binding AllTimeStat.Percent, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0">
                                    <Run Text="{Binding AllTimeStat.Completed, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding AllTimeStat.Total, Mode=OneWay}"/><Run Text=" tasks done"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{DynamicResource Warning}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Current streak" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <TextBlock FontSize="30" FontWeight="SemiBold" Margin="0,4,0,8">
                                    <Run Text="{Binding Streak, Mode=OneWay}"/><Run Text=" days" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                                </TextBlock>
                                <TextBlock Text="Days in a row with every task completed" Style="{StaticResource Muted}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Bar chart -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Daily completion %" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Hover a bar for details" Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="range" Content="Last 7 days"
                                                     IsChecked="{Binding SelectedChartRange, Converter={StaticResource Equals}, ConverterParameter='Last 7 days'}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="range" Content="Last 30 days"
                                                     IsChecked="{Binding SelectedChartRange, Converter={StaticResource Equals}, ConverterParameter='Last 30 days'}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid>
                                <!-- gridlines -->
                                <Grid Height="160" VerticalAlignment="Top" Margin="0,18,0,0">
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Center"/>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Bottom"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding ChartBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChartBar}">
                                            <StackPanel ToolTip="{Binding Tooltip}" Background="Transparent" Margin="2,0">
                                                <TextBlock Text="{Binding PercentText}" FontSize="10.5" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}" Height="18"/>
                                                <Grid Height="160">
                                                    <Border x:Name="bar" Height="{Binding BarHeight}" VerticalAlignment="Bottom"
                                                            MaxWidth="38" CornerRadius="5,5,0,0" Background="{DynamicResource Accent}" Opacity="0.75"/>
                                                </Grid>
                                                <TextBlock x:Name="lbl" Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"
                                                           Margin="0,6,0,0" Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="bar" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="lbl" Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Status bar -->
            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource Muted}" FontSize="12"
                       Margin="34,0,34,10"/>
        </Grid>
    </Grid>
</Window>
